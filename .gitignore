__pycache__/
*.py[cod]
*.egg-info/

# Never commit a libfprint checkout or its build output -- patches/ carries the diffs,
# and build.sh clones the fork itself.
/libfprint-egismoc-sdcp/
/sdcp/
build/
*.so
*.so.*
*.tar.gz

node_modules/
.DS_Store
*.swp

# dist/index.js IS committed on purpose: install.sh copies it, and installing by hand
# should not require a node toolchain. The sourcemap is not -- it is regenerated on every
# build and only churns the diff.
dist/*.map
